<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Supplier Emission</label>
    <pluralLabel>Supplier Emissions</pluralLabel>
    <nameField>
        <label>Supplier Emission Name</label>
        <type>AutoNumber</type>
        <displayFormat>SE-{0000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <description>ESG risk profile for supplier accounts including AI-calculated risk scores.</description>
    <fields>
        <fullName>Supplier__c</fullName>
        <label>Supplier</label>
        <type>Lookup</type>
        <referenceTo>Account</referenceTo>
        <relationshipName>Supplier_Emissions</relationshipName>
        <relationshipLabel>Supplier Emissions</relationshipLabel>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Risk_Score__c</fullName>
        <label>Risk Score</label>
        <type>Number</type>
        <precision>5</precision>
        <scale>2</scale>
        <required>false</required>
        <description>AI-calculated ESG risk score 0-100. Higher = more risk.</description>
    </fields>
    <fields>
        <fullName>ESG_Rating__c</fullName>
        <label>ESG Rating</label>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>A</fullName><label>A - Excellent</label></value>
                <value><fullName>B</fullName><label>B - Good</label></value>
                <value><fullName>C</fullName><label>C - Average</label></value>
                <value><fullName>D</fullName><label>D - Below Average</label></value>
                <value><fullName>F</fullName><label>F - Failing</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Scope3_Contribution__c</fullName>
        <label>Scope 3 Contribution (tCO2e)</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>4</scale>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Last_Audit_Date__c</fullName>
        <label>Last Audit Date</label>
        <type>Date</type>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Compliance_Status__c</fullName>
        <label>Compliance Status</label>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Compliant</fullName><label>Compliant</label><default>true</default></value>
                <value><fullName>At Risk</fullName><label>At Risk</label></value>
                <value><fullName>Non-Compliant</fullName><label>Non-Compliant</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
</CustomObject>
