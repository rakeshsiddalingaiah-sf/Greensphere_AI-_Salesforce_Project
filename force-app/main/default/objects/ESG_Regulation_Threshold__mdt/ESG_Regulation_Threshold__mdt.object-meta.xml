<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>ESG Regulation Threshold</label>
    <pluralLabel>ESG Regulation Thresholds</pluralLabel>
    <description>Custom metadata defining emission thresholds and scoring requirements for ESG regulations.</description>
    <fields>
        <fullName>Regulation_Code__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Regulation Code</label>
        <type>Text</type>
        <length>50</length>
    </fields>
    <fields>
        <fullName>Max_Emission_Tonnes__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Max Emission Threshold (tCO2e)</label>
        <type>Number</type>
        <precision>18</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Min_ESG_Score__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Minimum ESG Score Required</label>
        <type>Number</type>
        <precision>5</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Report_Frequency__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Report Frequency</label>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>Annual</fullName><label>Annual</label></value>
                <value><fullName>Quarterly</fullName><label>Quarterly</label></value>
                <value><fullName>Monthly</fullName><label>Monthly</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Penalty_Per_Tonne__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Penalty Per Excess Tonne (USD)</label>
        <type>Number</type>
        <precision>10</precision>
        <scale>2</scale>
    </fields>
    <fields>
        <fullName>Alert_Threshold_Pct__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Alert at % of Threshold</label>
        <type>Number</type>
        <precision>5</precision>
        <scale>1</scale>
        <description>Percentage of threshold at which to trigger early warning alert (e.g., 90 = alert at 90%)</description>
    </fields>
    <fields>
        <fullName>IsActive__c</fullName>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Is Active</label>
        <type>Checkbox</type>
        <defaultValue>true</defaultValue>
    </fields>
</CustomObject>
