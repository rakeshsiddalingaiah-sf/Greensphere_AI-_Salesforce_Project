<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Compliance Record</label>
    <pluralLabel>Compliance Records</pluralLabel>
    <nameField>
        <label>Compliance Record Name</label>
        <type>AutoNumber</type>
        <displayFormat>CR-{0000}</displayFormat>
    </nameField>
    <deploymentStatus>Deployed</deploymentStatus>
    <sharingModel>ReadWrite</sharingModel>
    <description>Tracks regulatory compliance status and AI-predicted probability for each regulation.</description>
    <fields>
        <fullName>Company__c</fullName>
        <label>Company</label>
        <type>Lookup</type>
        <referenceTo>Account</referenceTo>
        <relationshipName>Compliance_Records</relationshipName>
        <relationshipLabel>Compliance Records</relationshipLabel>
        <required>true</required>
    </fields>
    <fields>
        <fullName>Regulation__c</fullName>
        <label>Regulation</label>
        <type>Text</type>
        <length>255</length>
        <required>true</required>
        <description>e.g., CSRD, SEC Climate Rule, TCFD, GRI</description>
    </fields>
    <fields>
        <fullName>Compliance_Probability__c</fullName>
        <label>Compliance Probability (%)</label>
        <type>Percent</type>
        <precision>5</precision>
        <scale>1</scale>
        <required>false</required>
        <description>AI-predicted probability of meeting compliance requirements.</description>
    </fields>
    <fields>
        <fullName>Due_Date__c</fullName>
        <label>Due Date</label>
        <type>Date</type>
        <required>false</required>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <type>Picklist</type>
        <valueSet>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value><fullName>On Track</fullName><label>On Track</label><default>true</default></value>
                <value><fullName>At Risk</fullName><label>At Risk</label></value>
                <value><fullName>Overdue</fullName><label>Overdue</label></value>
                <value><fullName>Completed</fullName><label>Completed</label></value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Penalty_Risk_USD__c</fullName>
        <label>Penalty Risk (USD)</label>
        <type>Currency</type>
        <precision>18</precision>
        <scale>2</scale>
        <required>false</required>
        <description>Estimated financial penalty exposure if non-compliant.</description>
    </fields>
</CustomObject>
